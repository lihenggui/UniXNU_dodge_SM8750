__pycache__/
*.py[cod]

# Credentials and local identity, including inside allowed source directories.
.env*
.netrc
.npmrc
credentials.json
auth.json
platform.json
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# Original system material, firmware, archives and generated binaries.
kernelcache*
*.img
*.bin
*.dtb
*.dtbo
*.adt
*.dmg
*.im4p
*.im4m
*.apfs
*.dbr
*.mbn
*.fw
*.efi
*.fd
*.macho
*.elf
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb
*.map
*.zip
*.ipsw
*.nupkg
*.tar
*.gz
*.xz
*.zst
*.7z
*.log

# Editor state and local project files are not build inputs.
.idea/
.vscode/
*.code-workspace
*.xcodeproj/
*.xcworkspace/
*.sln
*.vcxproj*
.DS_Store
Thumbs.db
*.swp
