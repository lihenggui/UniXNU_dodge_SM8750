+    uint32_t enable = rx ? SE_DMA_RX_IRQ_EN_SET : SE_DMA_TX_IRQ_EN_SET;
+    uint32_t reset = rx ? SE_DMA_RX_FSM_RST : SE_DMA_TX_FSM_RST;
+    wr(s, clear, GENI_DMA_RESET_DONE);
+    wr(s, enable, GENI_DMA_RESET_DONE);
