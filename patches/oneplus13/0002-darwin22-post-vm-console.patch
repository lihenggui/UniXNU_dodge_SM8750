+// Bind an already mapped kernel console once, after VM/IOKit initialization.
+// The caller retains its IOMemoryMap for the boot lifetime. No early entry,
+// translation-table mutation or fabricated refresh event is involved.
+int boot_progress_bind_post_vm(uintptr_t base, unsigned w, unsigned h, unsigned pitch, unsigned depth)
+{
+    if (!geometry(base, w, h, pitch, depth)) return 0;
+    uint64_t flags = irq_disable();
+    if (__atomic_exchange_n(&console_lock, 1, __ATOMIC_ACQUIRE)) {
+        irq_enable(flags);
+        return 0;
+    }
+    if (framebuffer || panic_state || __atomic_load_n(&panic_cpu, __ATOMIC_ACQUIRE)) {
+        __atomic_store_n(&console_lock, 0, __ATOMIC_RELEASE);
+        irq_enable(flags);
+        return 0;
+    }
+    console_smp = 1;
+    boot_progress_bind(base, w, h, pitch, depth);
+    __atomic_store_n(&console_lock, 0, __ATOMIC_RELEASE);
+    irq_enable(flags);
+    return 1;
 }
 
