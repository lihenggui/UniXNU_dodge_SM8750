+def security_fixture_evidence(original_data, parent, entries, modules, initializers, fixture):
+    """Check reviewed code identities; this does not infer an initializer ABI."""
+    if (not isinstance(fixture, dict) or fixture.get('schema') != 1
+            or fixture.get('original_sha256') != hashlib.sha256(original_data).hexdigest()):
+        raise ValueError('Early security fixture schema or original input mismatch')
+    reviewed = fixture.get('initializers')
+    if not initializers or not isinstance(reviewed, dict) or set(reviewed) != set(initializers):
+        raise ValueError('Early security fixture must cover exactly the requested initializers')
+    evidence = {}
+    for identifier, address in initializers.items():
+        record = reviewed[identifier]
+        if (not isinstance(record, dict) or record.get('calling_convention') != 'void(void)'
+                or int(record['address'], 0) != address):
+            raise ValueError('Early security fixture address or calling convention mismatch')
+        if identifier not in modules or entries[identifier].get('AppleSecurityExtension') is not True:
+            raise ValueError('Early security fixture requires a selected security extension')
+        dependencies = record.get('required_dependencies')
+        if (not isinstance(dependencies, list) or not all(isinstance(dep, str) for dep in dependencies)
+                or set(dependencies) - set(entries[identifier].get('OSBundleLibraries', {}))):
+            raise ValueError('Early security fixture dependencies are not declared by the component')
+        code = record.get('code')
+        if not isinstance(code, list) or not code:
+            raise ValueError('Early security fixture needs reviewed executable ranges')
+        ranges, names = [], set()
+        for block in code:
+            va, size, name = int(block['va'], 0), block['size'], block['name']
+            if (type(size) is not int or size < 4 or size % 4 or va % 4 or not isinstance(name, str)
+                    or not name or name in names or not any(s['name'] == '__TEXT_EXEC' and s['initprot'] == 5
+                    and not s['maxprot'] & 2 and s['va'] <= va and va + size <= s['va'] + s['filesize']
+                    for s in modules[identifier]['segments'])):
+                raise ValueError('Invalid or non-executable early security fixture range')
+            at = backed_offset(parent, va, size, len(original_data))
+            digest = hashlib.sha256(original_data[at:at + size]).hexdigest()
+            if digest != block.get('sha256'):
+                raise ValueError('Early security fixture code hash mismatch')
+            names.add(name)
+            ranges.append({'name': name, 'va': va, 'size': size, 'sha256': digest})
+        if not any(block['va'] == address for block in ranges):
+            raise ValueError('Early security fixture lacks the requested entry code')
+        evidence[identifier] = {'original_address': address, 'calling_convention': 'void(void)',
+                                'code': ranges, 'required_dependencies': dependencies,
+                                'runtime_qualified': False}
+    return evidence
