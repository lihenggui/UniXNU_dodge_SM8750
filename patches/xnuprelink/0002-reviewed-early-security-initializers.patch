@@ -67,6 +67,58 @@
 
 
 class EmitTests(unittest.TestCase):
+    def test_reviewed_security_fixture(self):
+        native, original = images()
+        fixture = self.security_fixture(original)
+        _, report = emit(native, original, ['test.component'], 0x4000,
+                         {'test.component': 0x3000}, fixture)
+        self.assertEqual(report['early_security_evidence']['test.component']['code'][0]['va'], 0x3000)
+        self.assertFalse(report['early_security_evidence']['test.component']['runtime_qualified'])
+
+    @staticmethod
+    def security_fixture(original):
+        return {'schema': 1, 'original_sha256': hashlib.sha256(original).hexdigest(), 'initializers': {
+            'test.component': {'address': '0x3000', 'calling_convention': 'void(void)',
+                'required_dependencies': [], 'code': [{'name': 'entry', 'va': '0x3000', 'size': 4,
+                    'sha256': hashlib.sha256(original[0x2000:0x2004]).hexdigest()}]}}}
+
+    def test_refuse_changed_security_fixture_identity(self):
+        native, original = images()
+        for field, value in [('schema', 2), ('original_sha256', '0' * 64)]:
+            fixture = self.security_fixture(original)
+            fixture[field] = value
+            with self.subTest(field=field), self.assertRaisesRegex(ValueError, 'schema or original input mismatch'):
+                emit(native, original, ['test.component'], 0x4000, {'test.component': 0x3000}, fixture)
+        fixture = self.security_fixture(original)
+        with self.assertRaisesRegex(ValueError, 'exactly the requested'):
+            emit(native, original, ['test.component'], 0x4000, {}, fixture)
+
+    def test_refuse_unreviewed_security_fixture_entry_or_dependencies(self):
+        native, original = images()
+        changes = [('address', '0x3004', 'address or calling convention'),
+                   ('calling_convention', 'int(int)', 'address or calling convention'),
+                   ('required_dependencies', ['omitted.dependency'], 'dependencies are not declared')]
+        for field, value, message in changes:
+            fixture = self.security_fixture(original)
+            fixture['initializers']['test.component'][field] = value
+            with self.subTest(field=field), self.assertRaisesRegex(ValueError, message):
+                emit(native, original, ['test.component'], 0x4000, {'test.component': 0x3000}, fixture)
+
+    def test_refuse_changed_security_fixture_code_or_extent(self):
+        native, original = images()
+        changes = [('sha256', '0' * 64, 'code hash mismatch'),
+                   ('va', '0x2000', 'non-executable'), ('size', 0x1004, 'non-executable'),
+                   ('size', 3, 'non-executable')]
+        for field, value, message in changes:
+            fixture = self.security_fixture(original)
+            fixture['initializers']['test.component']['code'][0][field] = value
+            with self.subTest(field=field), self.assertRaisesRegex(ValueError, message):
+                emit(native, original, ['test.component'], 0x4000, {'test.component': 0x3000}, fixture)
+        fixture = self.security_fixture(original)
+        fixture['initializers']['test.component']['code'] *= 2
+        with self.assertRaisesRegex(ValueError, 'non-executable'):
+            emit(native, original, ['test.component'], 0x4000, {'test.component': 0x3000}, fixture)
+
