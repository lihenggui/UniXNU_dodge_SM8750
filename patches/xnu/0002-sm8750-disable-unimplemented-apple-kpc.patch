Disable unpublished Apple KPC and dependent KPERF; guard disabled sampling paths.
No hardware counter provider is selected for initial SM8750 bring-up.

diff --git a/bsd/kern/kern_ktrace.c b/bsd/kern/kern_ktrace.c
index 9f521f6..d5f80d3 100644
--- a/bsd/kern/kern_ktrace.c
+++ b/bsd/kern/kern_ktrace.c
@@ -207,9 +207,11 @@ ktrace_reset_internal(uint32_t reset_mask)
 		ktrace_active_mask &= ~reset_mask;
 	}
 
+#if KPERF
 	if (reset_mask & KTRACE_KPERF) {
 		kperf_reset();
 	}
+#endif
 	if (reset_mask & KTRACE_KDEBUG) {
 		kdebug_reset();
 	}
@@ -328,6 +330,11 @@ ktrace_configure(uint32_t config_mask)
 {
 	ktrace_assert_lock_held();
 	assert(config_mask != 0);
+#if !KPERF
+	if (config_mask & KTRACE_KPERF) {
+		return ENOTSUP;
+	}
+#endif
 
 	proc_t p = current_proc();
 
@@ -366,7 +373,9 @@ ktrace_disable(ktrace_state_t state_to_match)
 {
 	if (ktrace_state == state_to_match) {
 		kernel_debug_disable();
+#if KPERF
 		kperf_disable_sampling();
+#endif
 	}
 }
 
@@ -390,9 +399,11 @@ ktrace_kernel_configure(uint32_t config_mask)
 	}
 
 	if (ktrace_state != KTRACE_STATE_OFF) {
+#if KPERF
 		if (ktrace_active_mask & config_mask & KTRACE_KPERF) {
 			kperf_reset();
 		}
+#endif
 		if (ktrace_active_mask & config_mask & KTRACE_KDEBUG) {
 			kdebug_reset();
 		}
@@ -502,9 +513,11 @@ ktrace_set_owning_proc(proc_t p)
 			ktrace_state = KTRACE_STATE_BG;
 		} else {
 			if (ktrace_state == KTRACE_STATE_BG) {
+#if KPERF
 				if (ktrace_active_mask & KTRACE_KPERF) {
 					kperf_reset();
 				}
+#endif
 				if (ktrace_active_mask & KTRACE_KDEBUG) {
 					kdebug_reset();
 				}
