+    rules = XNU / 'makedefs/MakeInc.rule'
+    lines = rules.read_text().splitlines(keepends=True)
+    changed = False
+    for index, line in enumerate(lines):
+        if line.startswith(('C_RULE_1A=', 'P_RULE_1A=', 'S_RULE_1A=')) and '-MJ' not in line:
+            if ' -c ' not in line:
