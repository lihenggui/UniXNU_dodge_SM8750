@@ -30,7 +30,18 @@
 };
 class NativeAdrenoStatus final {
     uint64_t faults_=0,suspends_=0;
+    const uint32_t *lost_=nullptr,*recovering_=nullptr;
 public:
+    // Bind the publisher's boot-lifetime flags before exposing this connection.
+    // Counters describe ended work; they do not make a recovered device unusable.
+    void attachLifecycle(const uint32_t *lost,const uint32_t *recovering) {
+        lost_=lost;recovering_=recovering;
+    }
+    IOReturn availability() const {
+        if(lost_ && __atomic_load_n(lost_,__ATOMIC_ACQUIRE))return NativeAdrenoReturnNotResponding;
+        if(recovering_ && __atomic_load_n(recovering_,__ATOMIC_ACQUIRE))return kIOReturnBusy;
+        return kIOReturnSuccess;
+    }
     void noteFault() {__atomic_fetch_add(&faults_,1,__ATOMIC_RELAXED);}
     void noteSuspend() {__atomic_fetch_add(&suspends_,1,__ATOMIC_RELAXED);}
     uint64_t faults() const {return __atomic_load_n(&faults_,__ATOMIC_RELAXED);}
